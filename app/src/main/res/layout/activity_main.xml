<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            style="@style/SectionTitle"
            android:layout_marginTop="0dp"
            android:text="@string/status_title" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Body1" />

        <Button
            android:id="@+id/open_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_accessibility_settings" />

        <TextView
            android:id="@+id/restricted_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/restricted_help"
            android:textAppearance="@android:style/TextAppearance.Material.Body2" />

        <Button
            android:id="@+id/allow_restricted"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/allow_restricted" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/how_to_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/how_to_body"
            android:textAppearance="@android:style/TextAppearance.Material.Body1" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/voice_title" />

        <TextView
            android:id="@+id/rate_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Body1" />

        <SeekBar
            android:id="@+id/rate_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:max="55" />

        <TextView
            android:id="@+id/pitch_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Body1" />

        <SeekBar
            android:id="@+id/pitch_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:max="30" />

        <Switch
            android:id="@+id/highlight_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/highlight_text"
            android:textAppearance="@android:style/TextAppearance.Material.Body1" />

        <Switch
            android:id="@+id/floating_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/show_floating_button"
            android:textAppearance="@android:style/TextAppearance.Material.Body1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/floating_button_help"
            android:textAppearance="@android:style/TextAppearance.Material.Body2" />

        <Button
            android:id="@+id/tts_settings"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tts_settings" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/ocr_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/ocr_help"
            android:textAppearance="@android:style/TextAppearance.Material.Body1" />

        <RadioGroup
            android:id="@+id/ocr_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <RadioButton
                android:id="@+id/ocr_auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/ocr_auto" />

            <RadioButton
                android:id="@+id/ocr_always"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/ocr_always" />

            <RadioButton
                android:id="@+id/ocr_never"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/ocr_never" />
        </RadioGroup>

        <TextView
            style="@style/SectionTitle"
            android:text="@string/tile_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/tile_help"
            android:textAppearance="@android:style/TextAppearance.Material.Body1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tile_action_prompt"
            android:textAppearance="@android:style/TextAppearance.Material.Body1" />

        <RadioGroup
            android:id="@+id/tile_action_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/tile_action_select"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/tile_action_select" />

            <RadioButton
                android:id="@+id/tile_action_read_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/tile_action_read_all" />
        </RadioGroup>

        <Button
            android:id="@+id/tile_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tile_add" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/test_title" />

        <EditText
            android:id="@+id/test_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/test_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2"
            android:text="@string/test_default" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/test_speak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/speak" />

            <Button
                android:id="@+id/test_stop"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/stop" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
